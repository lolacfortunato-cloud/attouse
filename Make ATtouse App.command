#!/bin/bash
# Makes ATtouse into a real Mac app (the wallpaper widget) and a copy to send friends.
# Paste into Terminal:   bash ~/Downloads/Make\ ATtouse\ App.command

echo ""
echo "★ Making the ATtouse app ★"
if ! xcode-select -p >/dev/null 2>&1; then
  echo "Your Mac needs Apple's free Command Line Tools first. Click Install in the box that pops up, then run this again."
  xcode-select --install 2>/dev/null
  exit 0
fi
W="$(mktemp -d)"
APP="$W/ATtouse.app"
mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Resources" || { echo "❌ Couldn't make a work folder."; exit 1; }
cat > "$W/ATtouse.swift" <<'SWIFTEOF'
// ATtouse: the ATtouse.com gadget sitting on your wallpaper.
// It just opens the live ATtouse page, so new features and everyone's posts show up by themselves.
// You never have to download it again.
// First time: a normal window opens so you can sign in with your ATtouse username. Once your gadget loads,
// it shrinks into the little pear on your wallpaper.
// Menu bar ★: show/hide, size, move to corner, sign in again, quit.
// Drag the top edge of the gadget to move it. It remembers where you put it.

import Cocoa
import WebKit
import ServiceManagement

let URL_STRING = "https://lolacfortunato-cloud.github.io/attouse/"
let DESKTOP_LEVEL = NSWindow.Level(rawValue: Int(CGWindowLevelForKey(.desktopIconWindow)) + 1)
let BASE_W: CGFloat = 420, BASE_H: CGFloat = 288
let d = UserDefaults.standard
func onTopOn() -> Bool { d.bool(forKey: "attouse.ontop2") }   // off = sits behind your windows like a widget
var lastDown: NSEvent?

// Tells the Mac app when the gadget is loaded (or needs a sign in). Runs in every frame.
let STATUS_JS = """
(function(){
  if (window === window.top && !window.__attErr){
    window.__attErr = 1;
    var send = function(m){ try { window.webkit.messageHandlers.att.postMessage('err:' + String(m).slice(0, 300)); } catch (e) {} };
    window.addEventListener('error', function(e){ send((e.message || 'error') + ' @ ' + (e.filename || '').split('/').pop() + ':' + (e.lineno || '')); });
    window.addEventListener('unhandledrejection', function(e){ send('promise: ' + (e.reason && (e.reason.message || e.reason))); });
    setTimeout(function(){ var b = document.body; send('page: ' + location.host + location.pathname.slice(0, 40) + ' | title: ' + document.title + ' | text: ' + (b ? b.innerText.trim().slice(0, 80).replace(/\\s+/g, ' ') : 'none')); }, 6000);
  }
  if (window === window.top && !window.__attDrag){
    window.__attDrag = 1;
    document.addEventListener('mousedown', function(e){
      if (e.button !== 0) return;
      var t = e.target;
      if (!t || !t.closest || !t.closest('#device')) return;
      if (t.closest('button,a,input,textarea,select,label,canvas,iframe,img,.scroll,[data-go],[data-act],[contenteditable]')) return;
      try { window.webkit.messageHandlers.att.postMessage('drag'); } catch (err) {}
    }, true);
  }
  if (window.__attStatus) return; window.__attStatus = 1;
  var last = '';
  setInterval(function(){
    var s = document.documentElement && document.documentElement.dataset ? document.documentElement.dataset.atStatus : '';
    if (s && s !== last){ last = s; try { window.webkit.messageHandlers.att.postMessage(s); } catch (e) {} }
  }, 700);
})();
"""

final class ClickWebView: WKWebView {
    override func acceptsFirstMouse(for event: NSEvent?) -> Bool { true }
}
final class DragStrip: NSView {
    override func acceptsFirstMouse(for event: NSEvent?) -> Bool { true }
    override func mouseDown(with e: NSEvent) { window?.performDrag(with: e) }
}
final class FloatWindow: NSWindow {
    override var canBecomeKey: Bool { true }
    override var canBecomeMain: Bool { true }
}

// only one ATtouse at a time
if NSRunningApplication.runningApplications(withBundleIdentifier: Bundle.main.bundleIdentifier ?? "com.attouse.widget").count > 1 { exit(0) }
let app = NSApplication.shared
app.setActivationPolicy(.accessory)
let vf = NSScreen.main?.visibleFrame ?? NSRect(x: 0, y: 0, width: 1440, height: 900)

var scale = CGFloat(d.object(forKey: "attouse.scale") as? Double ?? 1.0)
let win = FloatWindow(contentRect: NSRect(x: vf.maxX - BASE_W - 12, y: vf.minY + 12, width: BASE_W, height: BASE_H),
                      styleMask: [.borderless], backing: .buffered, defer: false)
win.isOpaque = false
win.backgroundColor = .clear
win.hasShadow = false
win.isReleasedWhenClosed = false
win.collectionBehavior = [.canJoinAllSpaces, .fullScreenAuxiliary, .stationary, .ignoresCycle]

final class Controller: NSObject, WKScriptMessageHandler, WKNavigationDelegate, WKUIDelegate {
    var web: ClickWebView!
    let strip = DragStrip(frame: .zero)
    let container = NSView(frame: .zero)
    let note = NSTextField(labelWithString: "")
    var widget = false
    var manual = false   // you opened the full page yourself, so don't shrink it on you
    var gotReady = false
    var watchdog: DispatchWorkItem?
    var topItem: NSMenuItem?

    func makeWeb(hoist: Bool) {
        web?.configuration.userContentController.removeScriptMessageHandler(forName: "att")
        web?.removeFromSuperview()
        let config = WKWebViewConfiguration()
        config.websiteDataStore = .default()          // remembers your ATtouse sign in
        config.applicationNameForUserAgent = "Version/18.0 Safari/605.1.15 ATtouseWidget"
        config.preferences.javaScriptCanOpenWindowsAutomatically = true
        config.defaultWebpagePreferences.allowsContentJavaScript = true
        let ucc = config.userContentController
        ucc.addUserScript(WKUserScript(source: STATUS_JS, injectionTime: .atDocumentEnd, forMainFrameOnly: false))
        ucc.add(self, name: "att")
        let w = ClickWebView(frame: container.bounds, configuration: config)
        w.autoresizingMask = [.width, .height]
        w.setValue(!hoist ? true : false, forKey: "drawsBackground")   // white page while signing in, see-through as a widget
        if #available(macOS 13.3, *) { w.isInspectable = true }
        if #available(macOS 12.0, *) { w.underPageBackgroundColor = .clear }
        w.navigationDelegate = self
        w.uiDelegate = self
        container.addSubview(w, positioned: .below, relativeTo: strip)
        web = w
        if !hoist { showNote("Loading ATtouse… (if this stays blank, click ★ in the menu bar → Refresh)") } else { note.isHidden = true }
        w.load(URLRequest(url: URL(string: URL_STRING)!, cachePolicy: .reloadIgnoringLocalCacheData, timeoutInterval: 30))
    }

    func showNote(_ t: String) {
        note.stringValue = t
        note.isHidden = widget
        note.textColor = .secondaryLabelColor
        note.font = .systemFont(ofSize: 13)
        note.alignment = .center
        note.lineBreakMode = .byWordWrapping
        note.maximumNumberOfLines = 3
        if note.superview == nil { container.addSubview(note) }
        note.frame = NSRect(x: 20, y: container.bounds.height - 60, width: max(100, container.bounds.width - 40), height: 40)
        note.autoresizingMask = [.width, .minYMargin]
    }
    func webView(_ webView: WKWebView, didFinish navigation: WKNavigation!) { note.isHidden = true; if !widget { win.title = "ATtouse — " + (webView.url?.host ?? "") + " — sign in, then it shrinks onto your wallpaper" } }
    // the little pear on the wallpaper
    func widgetMode() {
        widget = true; gotReady = false; manual = false
        win.styleMask = [.borderless]
        win.isOpaque = false; win.backgroundColor = .clear; win.hasShadow = false
        win.level = onTopOn() ? .floating : DESKTOP_LEVEL
        sizeWidget(keepCorner: false)
        strip.isHidden = false
        makeWeb(hoist: true)
        win.orderFrontRegardless()
        // if the gadget never loads (signed out), open the normal page instead
        armWatchdog(seconds: 25)
    }

    // a normal window, for signing in
    func pageMode() {
        widget = false; gotReady = false
        watchdog?.cancel()
        win.styleMask = [.titled, .closable, .miniaturizable, .resizable]
        win.title = "ATtouse — sign in, then it shrinks onto your wallpaper"
        win.isOpaque = true; win.backgroundColor = .windowBackgroundColor; win.hasShadow = true
        win.level = .normal
        let v = win.screen?.visibleFrame ?? vf
        let size = NSSize(width: min(1000, v.width - 80), height: min(780, v.height - 60))
        win.setFrame(NSRect(x: v.midX - size.width / 2, y: v.midY - size.height / 2, width: size.width, height: size.height), display: true)
        container.frame = win.contentView?.bounds ?? .zero
        strip.isHidden = true
        makeWeb(hoist: false)
        win.makeKeyAndOrderFront(nil)
        NSApp.activate(ignoringOtherApps: true)
    }

    func armWatchdog(seconds: Double) {
        watchdog?.cancel()
        let w = DispatchWorkItem { [weak self] in
            guard let self = self, self.widget, !self.gotReady else { return }
            self.pageMode()
        }
        watchdog = w
        DispatchQueue.main.asyncAfter(deadline: .now() + seconds, execute: w)
    }

    func sizeWidget(keepCorner: Bool) {
        let old = win.frame
        let size = NSSize(width: BASE_W * scale, height: BASE_H * scale)
        var origin = keepCorner ? NSPoint(x: old.maxX - size.width, y: old.minY) : old.origin
        if let x = d.object(forKey: "attouse.pos.x") as? Double, let y = d.object(forKey: "attouse.pos.y") as? Double, !keepCorner {
            origin = NSPoint(x: x, y: y)
        }
        let r = NSRect(origin: origin, size: size)
        let visible = NSScreen.screens.contains { $0.frame.intersects(r.insetBy(dx: 40, dy: 40)) }
        win.setFrame(visible ? r : NSRect(x: vf.maxX - size.width - 12, y: vf.minY + 12, width: size.width, height: size.height), display: true)
        container.frame = NSRect(origin: .zero, size: size)
        // grab the top edge of the pear to drag it around
        strip.frame = NSRect(x: size.width * 0.18, y: size.height - 16 * scale, width: size.width * 0.5, height: 14 * scale)
        d.set(Double(scale), forKey: "attouse.scale")
    }

    func userContentController(_ c: WKUserContentController, didReceive m: WKScriptMessage) {
        guard let s = m.body as? String else { return }
        if s.hasPrefix("err:") {
            let line = String(s.dropFirst(4))
            let url = FileManager.default.homeDirectoryForCurrentUser.appendingPathComponent("Library/Logs/ATtouse.log")
            if let h = try? FileHandle(forWritingTo: url) { h.seekToEndOfFile(); h.write((line + "\n").data(using: .utf8)!); h.closeFile() }
            else { try? (line + "\n").write(to: url, atomically: true, encoding: .utf8) }
            if !widget { showNote(line); note.textColor = .systemRed }
            return
        }
        if s == "drag" {
            if widget, let e = lastDown { win.performDrag(with: e) }
            return
        }
        if s == "ready" {
            gotReady = true
            watchdog?.cancel()
            if !widget && !manual {
                d.set(true, forKey: "attouse.ok")
                DispatchQueue.main.asyncAfter(deadline: .now() + 1.2) { self.widgetMode() }
            }
        } else if (s == "signedout" || s == "signin") && widget {
            pageMode()
        }
    }

    // keep any pop-up pages inside this window instead of opening nowhere
    func webView(_ webView: WKWebView, createWebViewWith configuration: WKWebViewConfiguration, for navigationAction: WKNavigationAction, windowFeatures: WKWindowFeatures) -> WKWebView? {
        if navigationAction.targetFrame == nil { webView.load(navigationAction.request) }
        return nil
    }
    // if the web page crashes, quietly reload it
    func webViewWebContentProcessDidTerminate(_ webView: WKWebView) { webView.reload() }
    func webView(_ webView: WKWebView, didFail navigation: WKNavigation!, withError error: Error) { retrySoon(error) }
    func webView(_ webView: WKWebView, didFailProvisionalNavigation navigation: WKNavigation!, withError error: Error) { retrySoon(error) }
    func retrySoon(_ error: Error) {
        let e = error as NSError
        // normal redirects and cancelled loads aren't real failures
        if e.code == NSURLErrorCancelled || (e.domain == "WebKitErrorDomain" && e.code == 102) { return }
        if !widget { showNote("Couldn't load ATtouse (\(e.localizedDescription)). Trying again…") }
        // no wifi yet (like right after waking up): try again in a bit
        DispatchQueue.main.asyncAfter(deadline: .now() + 8) { [weak self] in self?.web.reload() }
    }

    var hiddenOnPurpose = false
    @objc func toggle() {
        if win.isVisible { hiddenOnPurpose = true; win.orderOut(nil) } else { hiddenOnPurpose = false; win.orderFrontRegardless(); if !widget { NSApp.activate(ignoringOtherApps: true) } }
    }
    @objc func small() { scale = 0.78; if widget { sizeWidget(keepCorner: true) } }
    @objc func medium() { scale = 1.0; if widget { sizeWidget(keepCorner: true) } }
    @objc func large() { scale = 1.35; if widget { sizeWidget(keepCorner: true) } }
    @objc func corner() {
        guard widget else { return }
        let v = win.screen?.visibleFrame ?? vf
        win.setFrameOrigin(NSPoint(x: v.maxX - win.frame.width - 12, y: v.minY + 12))
    }
    @objc func onTop() {
        let up = !onTopOn()
        d.set(up, forKey: "attouse.ontop2")
        topItem?.state = up ? .on : .off
        if widget { win.level = up ? .floating : DESKTOP_LEVEL }
    }
    @objc func signIn() { pageMode(); manual = true }
    @objc func openBrowser() { NSWorkspace.shared.open(URL(string: URL_STRING)!) }
    @objc func backToWidget() { widgetMode() }
    @objc func reload() { web.reload() }
    @objc func quit() { NSApp.terminate(nil) }
    var loginItem: NSMenuItem?
    // start ATtouse by itself when you log in (no Terminal needed)
    @objc func toggleLogin() {
        if #available(macOS 13.0, *) {
            let svc = SMAppService.mainApp
            if svc.status == .enabled { try? svc.unregister() } else { try? svc.register() }
            loginItem?.state = svc.status == .enabled ? .on : .off
        }
    }
}

let ctl = Controller()
win.contentView = ctl.container
ctl.container.autoresizesSubviews = true
ctl.container.addSubview(ctl.strip)

// closing the sign-in window just hides it
final class WinDelegate: NSObject, NSWindowDelegate {
    func windowShouldClose(_ sender: NSWindow) -> Bool { sender.orderOut(nil); return false }
    func windowDidResize(_ n: Notification) { if !ctl.widget { ctl.container.frame = win.contentView?.bounds ?? .zero } }
}
let winDelegate = WinDelegate()
win.delegate = winDelegate

let statusItem = NSStatusBar.system.statusItem(withLength: NSStatusItem.variableLength)
statusItem.button?.title = "★"
let menu = NSMenu()
for (title, action) in [("Show / Hide ATtouse", #selector(Controller.toggle)),
                        ("Size: Small", #selector(Controller.small)),
                        ("Size: Medium", #selector(Controller.medium)),
                        ("Size: Large", #selector(Controller.large)),
                        ("Move to Corner", #selector(Controller.corner)),
                        ("Float Above Windows", #selector(Controller.onTop)),
                        ("Refresh", #selector(Controller.reload)),
                        ("Open Full Page / Sign In", #selector(Controller.signIn)),
                        ("Back to Wallpaper Gadget", #selector(Controller.backToWidget)),
                        ("Open at Login", #selector(Controller.toggleLogin)),
                        ("Open in My Browser", #selector(Controller.openBrowser)),
                        ("Quit", #selector(Controller.quit))] {
    if title == "Quit" || title == "Size: Small" || title == "Refresh" { menu.addItem(.separator()) }
    let item = NSMenuItem(title: title, action: action, keyEquivalent: "")
    item.target = ctl
    menu.addItem(item)
    if title == "Float Above Windows" { ctl.topItem = item; item.state = onTopOn() ? .on : .off }
    if title == "Open at Login" { ctl.loginItem = item }
}
statusItem.menu = menu

// ---- stay exactly where you put it ----
var quietUntil = Date()
NotificationCenter.default.addObserver(forName: NSWindow.didMoveNotification, object: win, queue: .main) { _ in
    if !ctl.widget || Date() < quietUntil { return }
    d.set(Double(win.frame.minX), forKey: "attouse.pos.x"); d.set(Double(win.frame.minY), forKey: "attouse.pos.y")
}
func putBack() {
    guard ctl.widget, let x = d.object(forKey: "attouse.pos.x") as? Double, let y = d.object(forKey: "attouse.pos.y") as? Double else { return }
    let p = NSPoint(x: x, y: y)
    if NSScreen.screens.contains(where: { $0.frame.contains(NSPoint(x: p.x + win.frame.width / 2, y: p.y + 40)) }), win.frame.origin != p { win.setFrameOrigin(p) }
}
let settle: (Notification) -> Void = { _ in
    quietUntil = Date().addingTimeInterval(6)
    for delay in [0.3, 1.5, 3.5, 5.5] { DispatchQueue.main.asyncAfter(deadline: .now() + delay) { putBack() } }
}
NotificationCenter.default.addObserver(forName: NSApplication.didChangeScreenParametersNotification, object: nil, queue: .main, using: settle)
for n in [NSWorkspace.willSleepNotification, NSWorkspace.didWakeNotification, NSWorkspace.screensDidWakeNotification] {
    NSWorkspace.shared.notificationCenter.addObserver(forName: n, object: nil, queue: .main, using: settle)
}
// after waking up, refresh so posts are current
NSWorkspace.shared.notificationCenter.addObserver(forName: NSWorkspace.didWakeNotification, object: nil, queue: .main) { _ in
    DispatchQueue.main.asyncAfter(deadline: .now() + 4) { ctl.web?.reload() }
}

// first time it opens: turn on "Open at Login" so it's always on the wallpaper
if #available(macOS 13.0, *) {
    if !d.bool(forKey: "attouse.loginSet") { try? SMAppService.mainApp.register(); d.set(true, forKey: "attouse.loginSet") }
    ctl.loginItem?.state = SMAppService.mainApp.status == .enabled ? .on : .off
}
win.hidesOnDeactivate = false
// like a desktop widget: always there behind your windows, never disappears when other apps open
Timer.scheduledTimer(withTimeInterval: 2, repeats: true) { _ in
    guard ctl.widget, !ctl.hiddenOnPurpose else { return }
    let want = onTopOn() ? NSWindow.Level.floating : DESKTOP_LEVEL
    if win.level != want { win.level = want }
    if !win.isVisible { win.orderFrontRegardless() }
}
// remember each click so the page can say "drag me"; hold ⌘ and drag anywhere to move it too
NSEvent.addLocalMonitorForEvents(matching: .leftMouseDown) { e in
    lastDown = e
    if ctl.widget && e.window === win && e.modifierFlags.contains(.command) { win.performDrag(with: e); return nil }
    return e
}
if d.bool(forKey: "attouse.ok") { ctl.widgetMode() } else { ctl.pageMode() }
app.run()

SWIFTEOF

echo "Building (about a minute)..."
if ! swiftc -O -target arm64-apple-macos12 "$W/ATtouse.swift" -o "$W/arm" 2> "$W/b1.txt"; then
  echo "❌ Build failed. Send Claude a screenshot of this:"; head -20 "$W/b1.txt"; exit 1
fi
if swiftc -O -target x86_64-apple-macos12 "$W/ATtouse.swift" -o "$W/x86" 2> "$W/b2.txt"; then
  lipo -create "$W/arm" "$W/x86" -output "$APP/Contents/MacOS/ATtouse"
else
  cp "$W/arm" "$APP/Contents/MacOS/ATtouse"
fi

# the little pear icon
echo "" | base64 -D > "$W/icon.png" 2>/dev/null || echo "" | base64 --decode > "$W/icon.png"
mkdir -p "$W/i.iconset"
for s in 16 32 128 256 512; do
  sips -z "$s" "$s" "$W/icon.png" --out "$W/i.iconset/icon_${s}x${s}.png" >/dev/null 2>&1
  d=$((s*2)); sips -z "$d" "$d" "$W/icon.png" --out "$W/i.iconset/icon_${s}x${s}@2x.png" >/dev/null 2>&1
done
iconutil -c icns "$W/i.iconset" -o "$APP/Contents/Resources/AppIcon.icns" 2>/dev/null

cat > "$APP/Contents/Info.plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>CFBundleExecutable</key><string>ATtouse</string>
  <key>CFBundleIdentifier</key><string>com.attouse.widget</string>
  <key>CFBundleName</key><string>ATtouse</string>
  <key>CFBundleDisplayName</key><string>ATtouse</string>
  <key>CFBundleIconFile</key><string>AppIcon</string>
  <key>CFBundlePackageType</key><string>APPL</string>
  <key>CFBundleShortVersionString</key><string>1.0</string>
  <key>CFBundleVersion</key><string>1</string>
  <key>LSMinimumSystemVersion</key><string>12.0</string>
  <key>LSUIElement</key><true/>
</dict></plist>
PLIST
codesign --force --deep -s - "$APP" 2>/dev/null

# a copy to send friends (Mac apps have to be zipped to send)
rm -f "$HOME/Desktop/ATtouse-Mac.zip"
ditto -c -k --keepParent "$APP" "$HOME/Desktop/ATtouse-Mac.zip"

# install the widget on this Mac
launchctl bootout "gui/$(id -u)/com.attouse.widget" 2>/dev/null
rm -f "$HOME/Library/LaunchAgents/com.attouse.widget.plist"
pkill -x ATtouse 2>/dev/null
sleep 1
DEST="/Applications"
rm -rf "$DEST/ATtouse.app" 2>/dev/null
if ! cp -R "$APP" "$DEST/" 2>/dev/null; then DEST="$HOME/Applications"; mkdir -p "$DEST"; rm -rf "$DEST/ATtouse.app"; cp -R "$APP" "$DEST/"; fi
xattr -dr com.apple.quarantine "$DEST/ATtouse.app" 2>/dev/null
open "$DEST/ATtouse.app"
rm -rf "$W"

echo ""
echo "✅ ATtouse is on your Mac! A window opens: sign in with your ATtouse username, then it shrinks onto your wallpaper."
echo "   It opens by itself every time you log in. Look for ★ in the menu bar."
echo ""
echo "For friends: upload ATtouse-Mac.zip (on your Desktop) to your GitHub attouse repo, next to index.html."
echo "Then the Download for Mac button on the site works for everyone."
echo ""
